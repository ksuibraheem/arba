rules_version = '2';

/**
 * Arba Pricing — Firestore Security Rules
 * قواعد أمان Firestore لمنصة أربا
 * 
 * Zero-Knowledge Architecture:
 * - SuperAdmins CANNOT read calculation details or private customer data
 * - B2B subscribers own data is fully isolated
 * - All collections require authentication
 * 
 * 🏰 THE FORTRESS — Data Privacy & Security
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // =================== HELPER FUNCTIONS ===================

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Get user role from userRoles collection
    function getUserRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role;
    }

    // Check if user has a specific role
    function hasRole(role) {
      return isAuth() && getUserRole() == role;
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Check if user is superadmin
    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    // Check if user is a QS engineer
    function isEngineer() {
      return hasRole('qs_engineer');
    }

    // Check if user is the document owner
    function isOwner(ownerId) {
      return isAuth() && request.auth.uid == ownerId;
    }

    // Check if user is assigned to a project
    function isAssigned(assignedTo) {
      return isAuth() && request.auth.uid in assignedTo;
    }

    // =================== USER ROLES ===================
    // Users can read their own role, admins can read/write all
    // Users can CREATE their own role on registration (required by authService.ts)
    match /userRoles/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
      // SuperAdmins can read roles but NOT modify them
      allow read: if isSuperAdmin();
    }

    // =================== PROJECTS ===================
    // Owner and assigned engineers can read/write
    // SuperAdmins can list projects (metadata only) but NOT read calculation sub-collections
    match /projects/{projectId} {
      allow read: if isAuth() && (
        isOwner(resource.data.ownerId) ||
        isAssigned(resource.data.assignedTo) ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow create: if isAuth() && (isEngineer() || isAdmin());
      allow update: if isAuth() && (
        isOwner(resource.data.ownerId) ||
        isAssigned(resource.data.assignedTo) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // 🔒 ZERO-KNOWLEDGE: Calculation details sub-collection
      // SuperAdmins are BLOCKED from reading calculations
      match /calculations/{calcId} {
        allow read: if isAuth() && (
          isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) ||
          isAssigned(get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo) ||
          isAdmin()
        ) && !isSuperAdmin();
        allow write: if isAuth() && (
          isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) ||
          isEngineer() ||
          isAdmin()
        );
      }

      // 🔒 ZERO-KNOWLEDGE: Price history / audit trail sub-collection
      // SuperAdmins BLOCKED — only owner, assigned, and admin can read
      match /priceHistory/{historyId} {
        allow read: if isAuth() && (
          isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) ||
          isAssigned(get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo) ||
          isAdmin()
        ) && !isSuperAdmin();
        allow create: if isAuth(); // Any authenticated user can log price changes
        allow update, delete: if false; // Immutable audit trail
      }

      // Quotes sub-collection — accessible to project stakeholders
      match /quotes/{quoteId} {
        allow read: if isAuth() && (
          isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId) ||
          isAssigned(get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo) ||
          isAdmin()
        );
        allow write: if isAuth() && (isEngineer() || isAdmin());
      }
    }

    // =================== CLIENTS ===================
    // 🔒 ZERO-KNOWLEDGE: SuperAdmins CANNOT see client private data
    match /clients/{clientId} {
      allow read: if isAuth() && (
        isOwner(resource.data.ownerId) ||
        isAdmin()
      ) && !isSuperAdmin();
      allow create: if isAuth() && (isEngineer() || isAdmin());
      allow update: if isAuth() && (isOwner(resource.data.ownerId) || isAdmin());
      allow delete: if isAdmin();
    }

    // =================== USERS ===================
    // Authenticated users can create and manage their own profile document
    // This is REQUIRED for the registration flow (setDoc after createUserWithEmailAndPassword)
    match /users/{userId} {
      // Users can create their own document on sign-up
      allow create: if isAuth() && request.auth.uid == userId;
      // Users can read and update their own data
      allow read, update: if isAuth() && request.auth.uid == userId;
      // Admins can read/write all user documents
      allow read, write: if isAdmin();
    }

    // =================== USER IMPORTS ===================
    // Only the importing user and admins can access
    match /users/{userId}/imports/{importId} {
      allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());

      match /items/{itemId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // =================== SUBSCRIPTIONS ===================
    // Users can read their own, admins can manage all
    match /subscriptions/{subId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Never delete subscription records
    }

    // =================== BILLING / PAYMENTS ===================
    // Only the user themselves and accountant/admin can see payment records
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      ) && !isSuperAdmin();
      allow create: if isAuth();
      allow update: if isAdmin(); // Only admin/accountant can approve
      allow delete: if false;
    }

    // =================== SECURITY ALERTS ===================
    match /security_alerts/{alertId} {
      allow read: if isAuth() && (isAdmin() || isEngineer());
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // =================== ACTION LOGS ===================
    // Write-only for authenticated users, read for admin
    match /action_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false; // Immutable
    }

    // =================== SUPPLIER DATA ===================
    // Suppliers can manage their own data
    match /suppliers/{supplierId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        isOwner(resource.data.ownerId) ||
        isAdmin()
      );

      match /products/{productId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          isOwner(get(/databases/$(database)/documents/suppliers/$(supplierId)).data.ownerId) ||
          isAdmin()
        );
      }
    }

    // =================== DEMO SESSIONS ============================
    // Temporary storage for demo/test sessions — employees can read,
    // anyone (including demo users with no auth) can write their session.
    // Data is ephemeral and auto-expires through scheduled cleanup.
    match /demoSessions/{sessionId} {
      // Employees and admins can read all demo sessions (to simulate dashboard)
      allow read: if isAuth() && (isEngineer() || isAdmin());
      // Any authenticated user can create/update their OWN demo session doc
      allow create, update: if isAuth() && request.auth.uid == sessionId;
      // Admins can delete demo sessions
      allow delete: if isAdmin();

      // Sub-collection: projects within a demo session
      match /projects/{projectId} {
        allow read: if isAuth() && (isEngineer() || isAdmin());
        allow create, update: if isAuth() && request.auth.uid == sessionId;
        allow delete: if isAdmin();
      }
    }

    // =================== TEST SESSIONS ======================
    // Manager-created test sessions for demo mode users
    match /testSessions/{sessionId} {
      allow read: if isAuth() && (isEngineer() || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =================== ARBA CONFIG (Employees & Manager) ===================
    // بيانات الموظفين وبيانات المدير — حظر الوصول الحساس للعامة
    match /arba_config/{docId} {
      allow read: if docId != 'employees_data' && docId != 'manager_credentials';
      allow read, write: if isAuth() && isAdmin();
    }

    // =================== BRAIN DATA SYNC ===================
    match /brain_data/{userId} {
      allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      match /keys/{key} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }
    match /brain_health/{userId} {
      allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // =================== REGISTRATION REQUESTS ===================
    match /registration_requests/{requestId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow create: if true; // Allow unauthenticated registration
      allow update: if isAuth() && (
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =================== ACCOUNTING ===================
    // الفواتير والقيود — المالك أو المحاسب أو المدير فقط
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /ledger_entries/{entryId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /accounting_clients/{clientId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =================== SUPPLIER DATA (NEW) ===================
    // بيانات الموردين — المورد أو المدير فقط
    match /supplier_products/{productId} {
      allow read: if isAuth(); // All users can browse products
      allow write: if isAuth() && (
        isOwner(resource.data.supplierId) ||
        isAdmin()
      );
    }

    match /purchase_invoices/{invoiceId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.supplierId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /supplier_payments/{paymentId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.supplierId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // =================== CONNECT (Communication) ===================
    // الرسائل — المرسل أو المستقبل أو المدير فقط
    match /connect_messages/{messageId} {
      allow read: if isAuth() && (
        isOwner(resource.data.senderId) ||
        isOwner(resource.data.receiverId) ||
        isOwner(resource.data.projectOwnerId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.senderId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /connect_mail/{mailId} {
      allow read: if isAuth() && (
        isOwner(resource.data.senderId) ||
        isOwner(resource.data.receiverId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /connect_forms/{formId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.projectOwnerId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /connect_notes/{noteId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.projectOwnerId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /connect_gallery/{photoId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.projectOwnerId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        isOwner(resource.data.userId) || isAdmin()
      );
    }

    // =================== EMPLOYEES ===================
    // بيانات الموظفين — المدير أو صاحب الشركة فقط
    match /employees/{empId} {
      allow read: if isAuth() && (
        request.auth.uid == empId ||
        isAdmin()
      );
      allow write: if isAuth() && isAdmin();
    }

    // =================== NOTIFICATIONS ===================
    // الإشعارات — المستخدم المعني فقط
    match /notifications/{notifId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAuth() && isOwner(resource.data.userId);
    }

    // =================== ATTENDANCE ===================
    // الحضور — الموظف يقرأ سجلاته، المدير يقرأ ويكتب الكل
    match /attendance/{recordId} {
      allow read: if isAuth() && (
        isOwner(resource.data.employeeId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // =================== DISCOUNT REQUESTS ===================
    match /discount_requests/{requestId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =================== SUPPORT TICKETS ===================
    // تذاكر الدعم — صاحب التذكرة أو فريق الدعم
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.assignedTo) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.assignedTo) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =================== AUTH USERS ===================
    // بيانات المصادقة — المستخدم نفسه أو المدير فقط
    match /auth_users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =================== EXTERNAL SUPPLIERS ===================
    match /external_suppliers/{supplierId} {
      allow read: if isAuth(); // All users can browse suppliers
      allow write: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    match /external_prices/{priceId} {
      allow read: if isAuth(); // Price data is browsable
      allow write: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    // =================== SUPPLIER STORAGE ===================
    match /supplier_storage/{storageId} {
      allow read: if isAuth() && (
        isOwner(resource.data.supplierId) ||
        isAdmin()
      );
      allow write: if isAuth() && (
        isOwner(resource.data.supplierId) ||
        isAdmin()
      );
    }

    // =================== DATA CORRECTIONS ===================
    match /data_correction_requests/{requestId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /supplier_notifs/{notifId} {
      allow read: if isAuth() && (
        isOwner(resource.data.supplierId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // =================== COMPANY SETTINGS ===================
    // إعدادات الشركة — المدير أو المالك فقط
    match /company_settings/{settingId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.companyId) ||
        isAdmin()
      );
      allow write: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    match /company_employees/{empId} {
      allow read: if isAuth() && (
        isOwner(resource.data.companyId) ||
        request.auth.uid == empId ||
        isAdmin()
      );
      allow write: if isAuth() && (
        isOwner(resource.data.companyId) ||
        isAdmin()
      );
    }

    // =================== INVOICE EDIT REQUESTS ===================
    match /invoice_edit_requests/{requestId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =================== SUPPLIER REVIEWS ===================
    // التقييمات — الكاتب أو المورد المعني أو المدير
    match /supplier_reviews/{reviewId} {
      allow read: if isAuth(); // Reviews are public to authenticated users
      allow create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =================== SOVEREIGN v8.0: Temporal Audit System ===================
    
    // Price Time Series — append-only historical price tracking
    match /price_time_series/{entryId} {
      allow read: if isAuth() && (isAdmin() || isEngineer());
      allow create: if isAuth();
      allow update, delete: if false; // Immutable — price history cannot be altered
    }

    // Usage Metering — API/token consumption tracking
    match /usage_metering/{entryId} {
      allow read: if isAuth() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuth();
      allow update, delete: if false; // Immutable
    }

    // Audit Trail — immutable change log
    match /audit_trail/{entryId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false; // Immutable — compliance requirement
    }

    // =================== SOVEREIGN v8.1: Internal Governance ===================

    // Internal Metadata — brain-only data, NEVER exposed to client UI
    match /internal_metadata/{itemId} {
      allow read: if isAdmin(); // Only admins/system can read
      allow create, update: if isAuth(); // System stamps metadata on calculations
      allow delete: if false; // Metadata is preserved for historical analysis
    }

    // Sweep History — supplier audit cycle results (append-only)
    match /sweep_history/{sweepId} {
      allow read: if isAuth() && isAdmin();
      allow create: if isAuth();
      allow update, delete: if false; // Immutable audit record
    }

    // =================== V10.0: SUBSCRIPTION & RFQ SYSTEM ===================

    // Upgrade History — immutable subscription change log
    match /upgradeHistory/{historyId} {
      allow read: if isAuth() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuth(); // System creates on plan change
      allow update, delete: if false; // Immutable financial record
    }

    // Usage Tracking — per-user quotas and consumption
    match /usageTracking/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // RFQ Orders — supplier-client transactions
    // 🔒 Suppliers see their orders, clients see their orders, nobody else
    match /supplierRFQs/{rfqId} {
      allow read: if isAuth() && (
        resource.data.supplierId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth(); // Any authenticated client can create RFQ
      allow update: if isAuth() && (
        resource.data.supplierId == request.auth.uid || // Supplier can accept/deliver
        resource.data.clientId == request.auth.uid ||   // Client can complete/rate
        isAdmin()
      );
      allow delete: if false; // Never delete transaction records
    }

    // Supplier Storage Purchases — immutable purchase records
    match /supplierStoragePurchases/{purchaseId} {
      allow read: if isAuth() && (
        resource.data.supplierId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update, delete: if false; // Immutable financial record
    }

    // =================== DEFAULT: DENY ALL ===================
    // Any collection not explicitly matched is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
